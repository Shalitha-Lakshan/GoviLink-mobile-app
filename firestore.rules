rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. User Profiles
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // 2. Produce Marketplace Listings
    match /produce/{produceId} {
      // Anyone can browse listings; authenticated users can add/edit/delete
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Orders Collection
    match /orders/{orderId} {
      // Authenticated buyers, farmers, and drivers can read and update orders
      allow read, write: if request.auth != null;
    }

    // 4. Buyer Custom Requests (Required for "I'll Provide" and Custom Orders)
    match /buyer_requests/{requestId} {
      // Authenticated farmers and buyers can read, create, update, and delete requests
      allow read, write: if request.auth != null;
    }
  }
}
