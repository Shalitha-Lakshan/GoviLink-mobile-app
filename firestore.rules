rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── USERS ──────────────────────────────────────────────
    // Any authenticated user can read profiles (needed for driver listings, farmer info, etc.)
    // Users can only write to their own profile document.
    match /users/{userId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ── PRODUCE LISTINGS ───────────────────────────────────
    // Any authenticated user can read produce.
    // Any authenticated user can create. Only the farmer who owns it can update/delete.
    match /produce/{produceId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
                       (resource.data.farmerUid == request.auth.uid ||
                        resource.data.farmerId  == request.auth.uid ||
                        resource.data.farmerId  == 'farmer_uid' ||
                        !('farmerUid' in resource.data));
      allow delete: if request.auth != null &&
                       (resource.data.farmerUid == request.auth.uid ||
                        resource.data.farmerId  == request.auth.uid ||
                        resource.data.farmerId  == 'farmer_uid' ||
                        !('farmerUid' in resource.data));
    }

    // ── ORDERS ─────────────────────────────────────────────
    // Any authenticated user can read/write orders.
    match /orders/{orderId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ── NOTIFICATIONS ──────────────────────────────────────
    // Any authenticated user can read/write notifications.
    match /notifications/{notificationId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ── BUYER REQUESTS ─────────────────────────────────────
    // Any authenticated user can read/write buyer requests.
    match /buyerRequests/{requestId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ── VEHICLES ───────────────────────────────────────────
    // Any authenticated user can read vehicles.
    // Only the owning driver can modify their own vehicles.
    match /vehicles/{vehicleId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
                       resource.data.driverUid == request.auth.uid;
      allow delete: if request.auth != null &&
                       resource.data.driverUid == request.auth.uid;
    }
  }
}
