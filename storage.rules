rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /produce_images/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /vehicle_images/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /proof_images/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /profile_images/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
